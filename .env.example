# Base de données PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://cf:cf@localhost:5432/cheminsetfontaines?schema=public"

# Adresse de notification des demandes d'adhésion et messages de contact
NOTIFY_EMAIL="contact@cheminsetfontaines.fr"

# --- Brevo (v0.2, relay transactionnel — clé à créer sur brevo.com, JAMAIS dans le repo) ---
# BREVO_API_KEY=""
# BREVO_LIST_ID=""

# --- Stripe (v2 : webhook des dons — voir docs/SECRETS.md) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Agent Strava (brique ultérieure — OAuth, jamais dans le repo) ---
# STRAVA_CLIENT_ID=""
# STRAVA_CLIENT_SECRET=""
# STRAVA_REFRESH_TOKEN=""

# --- Génération de texte de l'agent (clé Mistral) ---
# MISTRAL_API_KEY=""

# --- Back-office (brique B0) ---
# Secret de session Auth.js : openssl rand -base64 32 (JAMAIS dans le repo)
# AUTH_SECRET=""
# Premier compte admin, créé par `npm run db:seed` (à retirer ensuite du .env)
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME="Bureau C&F"

# --- Viewer GPX back-office (B3-GPX) : cle MapTiler (satellite + terrain RGB) ---
# Compte gratuit sur maptiler.com > Dashboard > Credentials ; JAMAIS dans le repo
# MAPTILER_KEY=""
