// Schéma Prisma — Chemins et Fontaines (v0.1)
// Correspondance collections Framer -> tables :
//   ROUTES -> Route (+ RoutePhoto), EVENTS -> Event, NEWSLETTERS -> Newsletter,
//   SUBSCRIBERS -> Subscriber (source de vérité locale, double opt-in).
// Nouvelles tables refonte : Commune (Xaintrie), MembershipRequest,
// ContactMessage, Member/MemberYear (brique N2 adhérents).
// Extension prévue agent Strava : StravaActivity (§7 des spécifications),
// publiée APRÈS validation humaine par clonage dans Route (source="strava").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  facile
  moyen
  difficile
}

enum ContentStatus {
  published
  draft
}

enum SubscriberStatus {
  pending
  subscribed
  unsubscribed
  invalid
}

enum SubscriptionSource {
  formulaire
  import
  adhesion
}

enum UserRole {
  admin
  bureau
}

// Comptes du back-office (B0) : Auth.js Credentials, hash bcryptjs.
// Le premier compte admin est créé par le seed (ADMIN_EMAIL/ADMIN_PASSWORD).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(bureau)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Commune {
  id            String   @id @default(cuid())
  name          String   @unique // nom canonique INSEE (ex. "Saint-Chamant")
  slug          String   @unique
  inseeCode     String? // ex. "19192"
  lat           Float?
  lng           Float?
  // Truth de regroupement des itinéraires (Q16) ; le libellé d'affichage
  // historique (ex. "St-Chamand") est conservé sur Route.townshipLabel.
  routes        Route[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Route {
  id             String     @id @default(cuid())
  slug           String     @unique // normalisé (Q2) : sans accents, tirets simples
  legacySlug     String? // slug Framer d'origine, pour audit 301
  title          String
  detailsRaw     String // texte Framer d'origine ("12 kms - dénivellé 280m - niveau facile")
  distanceKm     Float?
  elevationGainM Int?
  difficulty     Difficulty?
  description    String
  gpxFileName    String? // nom lisible pour le téléchargement (ex. "Auriac_CdF_2024.gpx")
  gpxUrl         String? // fallback Framer tant que public/gpx/<slug>.gpx est absent
  imageUrl       String?
  imageAlt       String?
  townshipLabel  String // libellé Township Framer d'origine (affichage à l'identique)
  commune        Commune?   @relation(fields: [communeId], references: [id])
  communeId      String?
  status         ContentStatus @default(published)
  hasPhotoAlbum  Boolean    @default(false) // badge « Album photos » de la page publique (toggle Framer Has Photo Album)
  source         String     @default("saisie_manuelle") // saisie_manuelle | strava
  sourceStravaId String?
  // Etat camera du viewer GPX au moment de la capture 1200x800 :
  // { lng, lat, zoom, bearing, pitch } — permet de re-ouvrir le viewer
  // dans la meme position pour recadrer la photo principale.
  viewerCamera   Json?
  photos         RoutePhoto[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([communeId])
  @@index([status])
}

model RoutePhoto {
  id        String  @id @default(cuid())
  title     String
  imageUrl  String
  imageAlt  String?
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId   String
  createdAt DateTime @default(now())
}

model Event {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  dateLabel   String // libellé affiché à l'identique ("31 OCT 2026 · 14:00")
  sortDate    DateTime? // pour "3 derniers" de la home (dates sans année : à compléter à publication)
  details     String
  imageUrl    String?
  imageAlt    String?
  status      ContentStatus @default(published)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortDate])
}

// Brique N3 (spec §4.3/§6) : workflow brouillon → pret → valide_envoyee
// → archivee ; modèle d'habillage et contenu par blocs (Json) + snapshot
// figé à la génération. Les anciens numéros (archive Mailchimp) gardent
// externalUrl : la page d'archive publique les montre toujours, les
// brouillons n'y paraissent jamais.
enum NewsletterStatus {
  brouillon // autogénérée ou en rédaction : invisible côté front
  pret // relue, prête pour validation (l'envoi réel arrive avec la brique N4)
  valide_envoyee // envoyée aux souscripteurs (brique N4)
  archivee // publiée sur fr/newsletters
}

model NewsletterTemplate {
  id          String        @id @default(cuid())
  name        String // « Standard charte » (v1 : un seul modèle, spec §6.1)
  isDefault   Boolean       @default(false)
  newsletters Newsletter[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Newsletter {
  id               String             @id @default(cuid())
  slug             String             @unique
  title            String
  publicationDate  DateTime
  publicationLabel String // "Septembre 2026"
  summary          String
  coverImageUrl    String?
  featured          String? // "Featured Route Or Township"
  externalUrl      String? // archive Mailchimp conservée
  // Brique N3 (spec §4.3/§6.2) :
  status           NewsletterStatus   @default(brouillon)
  templateId       String?
  template         NewsletterTemplate? @relation(fields: [templateId], references: [id])
  blocks           Json? // tableau de blocs (lib/newsletters.ts, spec §6.2)
  snapshot         Json? // données figées à la génération : { generatedAt, events, route }
  testedAt         DateTime? // dernier test envoyé (garde-fou avant l'envoi réel, brique N4)
  testedBlocksHash String? // empreinte des blocs testés : modifier invalide le test (lib/newsletters.ts)
  sentAt           DateTime? // date d'envoi réel (brique N4)
  recipientCount   Int? // statistiques d'envoi (brique N4)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Subscriber {
  id               String             @id @default(cuid())
  email            String             @unique
  firstName        String?
  lastName        String?
  phone            String?
  language         String             @default("fr")
  status           SubscriberStatus   @default(pending)
  source           SubscriptionSource @default(formulaire)
  confirmedAt      DateTime?
  // Brique N1 « Remplacement Mailchimp » (spec du 25/11/2026, §4.1/§5.2) :
  // double opt-in interne. confirmToken : lien de confirmation à usage
  // unique (32 octets hex), valable 30 jours après son envoi ; unsubToken :
  // lien de désinscription en 1 clic ; lastEmailAt : garde anti-renvoi
  // (max 1 e-mail de confirmation par heure) et base de la validité du lien.
  confirmToken     String?            @unique
  unsubToken       String?            @unique
  lastEmailAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model MembershipRequest {
  id         String   @id @default(cuid())
  civilite   String? // Madame | Monsieur | Autre
  firstName  String?
  lastName   String?
  address    String?
  email      String
  phone      String?
  postalCode String?
  city       String?
  country    String? // France | Belgique | Suisse | Autre
  // Brique N2 « Remplacement Mailchimp » (spec §4.2/§5.1) : cases cochées
  // au formulaire (jamais par défaut, RGPD) + jeton de confirmation de
  // l'e-mail, même mécanique que le double opt-in souscripteurs (usage
  // unique, valable 30 jours, garde anti-renvoi 1 h via lastEmailAt).
  newsletter   Boolean   @default(false) // case « nouvelles du sentier »
  photoConsent Boolean   @default(false) // droit à l'image (jamais par défaut)
  confirmToken String?   @unique
  confirmedAt  DateTime? // clic sur le lien fr/adhesion/confirmation
  lastEmailAt  DateTime? // garde anti-renvoi : 1 e-mail de confirmation max/h
  memberId     String? // membre créé lors de la validation de la cotisation
  member       Member?  @relation(fields: [memberId], references: [id])
  handledAt  DateTime? // traité par le bureau
  createdAt  DateTime @default(now())
}

// Adhérents (brique N2, spec §4.2) : MembershipRequest reste l'entrée du
// formulaire public ; le bureau valide la cotisation => la demande devient
// un Member stable d'année en année (merge sur l'e-mail à la ré-adhésion).
// Statut « à renouveler » : NON stocké — dérivé dans /admin/members
// (membre actif sans MemberYear de la saison en cours).
enum MemberStatus {
  demande_recue // valeur de référence du catalogue (parcours conservé sur la demande)
  email_confirme // idem : la demande porte confirmedAt
  actif // cotisation de la saison validée par le bureau
  sorti
}

model Member {
  id             String       @id @default(cuid())
  email          String       @unique
  civilite       String?
  firstName      String?
  lastName       String?
  address        String?
  postalCode     String?
  city           String?
  country        String?
  phone          String?
  newsletter     Boolean      @default(false) // case reçue au formulaire
  consentAt      DateTime // consentement RGPD horodaté (= confirmation d'e-mail)
  photoConsent   Boolean      @default(false) // droit à l'image (jamais par défaut)
  status         MemberStatus @default(actif)
  lastReminderAt DateTime? // garde : jamais 2 rappels de renouvellement à moins de 30 jours
  years          MemberYear[]
  requests       MembershipRequest[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

// Cotisation d'une saison : année civile (décision D6), hors-ligne (D2).
model MemberYear {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  season    Int // 2026, 2027… (année civile, décision D6)
  paidAt    DateTime // date d'encaissement de la cotisation
  amount    Float? // facultatif, suivi interne
  createdAt DateTime @default(now())

  @@unique([memberId, season])
  @@index([season])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  handledAt DateTime?
  createdAt DateTime  @default(now())
}

// Brique N0 « Remplacement Mailchimp » (spec du 25/11/2026) : file/journal de
// TOUS les e-mails émis par le site (transactionnels N0-N2, newsletter N3-N4).
// status : queued (créée) | sent (accepté par le SMTP) | failed (erreur SMTP,
// reprise via le back-office en N4) | skipped (SMTP_HOST absent : environnement
// sans envoi configuré, ex. CI — l'enregistrement applicatif reste la vérité).
model EmailOutbox {
  id           String    @id @default(cuid())
  kind         String // contact_notification | nl_confirmation | newsletter… (spec §5.3)
  toEmail      String
  subject      String
  status       String    @default("queued")
  error        String?
  attempts     Int       @default(0)
  subscriberId String? // non contraint en N0 : les refs arrivent en N1/N3
  memberId     String?
  newsletterId String?
  requestedAt  DateTime  @default(now())
  sentAt       DateTime?

  @@index([status, requestedAt])
}

// Brique S0 « Agent Strava » (spec cf-spec-agent-strava du 26/11/2026) :
// tracés importés des activités Strava (Walk/Hike uniquement) et traités en
// 3 listes : NEW -> SELECTED -> BUFFER -> CONSUMED ; DELETED = tombestone
// anti-resynchronisation (jamais réimporté). stravaId est stocké en String :
// Strava passera les ids d'activité en 64 bits après juin 2027.
// routeId est un simple pointeur sans FK : supprimer l'itinéraire ne doit pas
// effacer l'historique des tracés (règle anti-doublon du chantier).
model StravaTrace {
  id           String           @id @default(cuid())
  stravaId     String           @unique
  stravaTitle  String           // dernier titre vu sur Strava
  localTitle   String           // titre éditable dans le back-office
  titleSource  TraceTitleSource @default(strava)
  sportType    String           // "Walk" | "Hike"
  startTime    DateTime         // départ de l'activité (locale Strava)
  distanceM    Float?
  elevDiffM    Float?
  status       TraceStatus      @default(NEW)
  gpxContent   String?          // GPX (Streams -> GPX), rempli à la sélection (D4)
  gpxFetchedAt DateTime?
  routeId      String?          // itinéraire créé depuis cette trace (CONSUMED)
  syncedAt     DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, startTime])
}

enum TraceTitleSource {
  strava // titre non renommé localement : la sync peut le rafraîchir
  local  // renommé localement : la sync ne touche plus le titre
}

enum TraceStatus {
  NEW       // liste 1 « Tracés Strava »
  SELECTED  // liste 2 « Sélectionnés » (GPX téléchargé)
  BUFFER    // liste 3 « Prêts à publier » (stock tampon)
  CONSUMED  // itinéraire créé (rattaché à routeId)
  DELETED   // supprimé par le bureau : tombestone, jamais resynchronisé
}

// Brique S1 : jetons OAuth Strava (une seule ligne = un seul athlète, Olivier).
// accessToken/refreshToken sont chiffrés applicativement (AES-GCM, clé dérivée
// d'AUTH_SECRET) — jamais en clair en base, jamais dans le repo (spec §8).
model StravaCredential {
  id           String   @id @default(cuid())
  athleteId    String   @unique
  athleteName  String   // affiché dans le bandeau de connexion
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  updatedAt    DateTime @updatedAt
}
